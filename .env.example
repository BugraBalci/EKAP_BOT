# EntropyWork MSA e-posta API
ENTROPY_EMAIL_API_URL=https://msa.entropywork.com/api/send-email
ENTROPY_EMAIL_API_KEY=YOUR_API_KEY_HERE
ENTROPY_EMAIL_FROM=info@entropywork.com

# Sabah özeti alıcıları (virgülle) — lokal + GitHub Actions secret ile aynı isim
EKAP_EMAIL_RECIPIENTS=balcibugra4@gmail.com

# Yedek SMTP (MSA API yoksa cron_bot.py kullanır)
SENDER_MAIL=your.sender@gmail.com
SENDER_PASSWORD=your-app-password

# Ortak Google Takvim (service account JSON: ham JSON, base64 veya dosya yolu)
# Takvimi service account e-postası ile "Etkinlikleri değiştirme" yetkisiyle paylaşın.
# AUTO_SYNC_CALENDAR=true olmadıkça tüm ihaleler ortak takvime yazılmaz;
# maildeki "Takvime Ekle" bağlantısı kullanılır.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
AUTO_SYNC_CALENDAR=false
